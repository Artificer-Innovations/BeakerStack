{
  "name": "web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:articles -w @beakerstack/articles && tsc && vite build && vite-node scripts/prerender-home.ts && vite-node scripts/prerender-articles.ts",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage --run",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.vite"
  },
  "dependencies": {
    "@beakerstack/admin": "^1.0.0",
    "@beakerstack/articles": "^1.0.0",
    "@beakerstack/billing": "^1.0.0",
    "@beakerstack/connections": "^1.0.0",
    "@beakerstack/email": "^1.0.0",
    "@beakerstack/help": "^1.0.0",
    "@beakerstack/logger": "^1.0.0",
    "@beakerstack/observability": "^1.0.0",
    "@beakerstack/shared": "^2.0.0",
    "@beakerstack/waitlist": "^1.0.0",
    "@sentry/react": "^8.55.2",
    "@supabase/supabase-js": "^2.38.0",
    "lucide-react": "^0.460.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^8.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@rolldown/pluginutils": "^1.0.0-beta.47",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.3.0",
    "vite": "^7.3.5",
    "vite-node": "^5.3.0",
    "vitest": "^4.1.8"
  }
}
