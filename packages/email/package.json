{
  "name": "@beakerstack/email",
  "version": "1.0.0",
  "description": "Transactional email adapter interface for BeakerStack",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src --ext ts --report-unused-disable-directives --max-warnings 0",
