{
  "name": "@beakerstack/shared",
  "version": "2.0.0",
  "description": "Shared components, hooks, and utilities for cross-platform development",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "lint": "eslint src/**/*.{ts,tsx}",
    "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
