{
  "name": "@beakerstack/adopter-tests",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "test": "npm run test:mobile",
    "test:mobile": "jest --config ./jest.mobile.cjs --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "npm run test:coverage:mobile && npm run test:coverage:merge-into-mobile",
    "test:coverage:mobile": "jest --config ./jest.mobile.cjs --coverage --runInBand --detectOpenHandles --forceExit",
    "test:coverage:merge-into-mobile": "node ./scripts/merge-into-mobile.cjs"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-preset-expo": "^54.0.6",
    "jest": "^29.7.0",
    "react": "18.2.0",
    "react-native": "0.73.6",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.3.3"
  }
}
