{
  "name": "@beakerstack/shared-tests",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "test": "npm run test:web && npm run test:native",
    "test:web": "jest --config ./jest.web.cjs",
    "test:native": "NATIVE_TESTS=true jest --config ./jest.native.cjs",
    "test:coverage": "npm run test:coverage:web && npm run test:coverage:native && npm run test:coverage:merge",
    "test:coverage:web": "jest --config ./jest.web.cjs --coverage",
    "test:coverage:native": "NATIVE_TESTS=true jest --config ./jest.native.cjs --coverage",
    "test:coverage:merge": "node scripts/merge-coverage.cjs"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/preset-react": "^7.25.0",
    "@babel/preset-typescript": "^7.25.0",
    "@supabase/supabase-js": "^2.38.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-native": "^13.2.2",
    "babel-jest": "^29.7.0",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-preset-expo": "~57.0.2",
    "expo": "~57.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-expo": "~57.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.0",
    "react-native-web": "^0.21.2",
    "react-test-renderer": "19.2.8",
    "typescript": "^5.3.3",
    "ws": "^8.21.0",
    "zod": "^3.22.0",
    "@react-native/jest-preset": "0.86.0"
  }
}
