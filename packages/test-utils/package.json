{
  "name": "@beakerstack/test-utils",
  "version": "0.0.1",
  "description": "Testing utilities for BeakerStack-based projects",
  "keywords": [
    "beakerstack",
    "testing",
    "utilities",
    "test-helpers"
  ],
  "homepage": "https://github.com/Artificer-Innovations/BeakerStack/tree/main/packages/test-utils",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Artificer-Innovations/BeakerStack.git",
    "directory": "packages/test-utils"
  },
  "bugs": {
    "url": "https://github.com/Artificer-Innovations/BeakerStack/issues"
  },
  "license": "MIT",
  "author": "Artificer Innovations, LLC",
  "contributors": [
    "Brad Hefta-Gaub <brad@hefta-gaub.com> (https://github.com/ZappoMan)"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
