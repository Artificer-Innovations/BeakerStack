{
  "name": "beakerstack",
  "version": "2026.1.0",
  "description": "Ship your SaaS faster — opinionated Supabase template for web (React + Vite) and mobile (Expo), with billing, PR previews, and staged CI/CD.",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "keywords": [
    "beakerstack",
    "monorepo",
    "template",
    "starter",
    "boilerplate",
    "full-stack",
    "fullstack",
    "supabase",
    "react",
    "react-native",
    "expo",
    "vite",
    "typescript",
    "web",
    "mobile",
    "cross-platform",
    "pr-previews",
    "ci-cd",
    "aws",
    "open-source"
  ],
  "homepage": "https://github.com/Artificer-Innovations/BeakerStack#readme",
  "bugs": {
    "url": "https://github.com/Artificer-Innovations/BeakerStack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Artificer-Innovations/BeakerStack.git"
  },
  "author": "Artificer Innovations, LLC",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "contributors": [
    "Brad Hefta-Gaub <brad@hefta-gaub.com> (https://github.com/ZappoMan)"
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Artificer-Innovations"
  },
  "scripts": {
    "sync-icons": "node scripts/sync-icon-assets.js",
    "generate-favicons": "node scripts/generate-favicons.js",
    "mobile": "cd apps/mobile && npm start",
    "mobile:ios": "cd apps/mobile && npx expo start --dev-client --port 8082",
    "mobile:android": "cd apps/mobile && npx expo start --dev-client --port 8082",
    "mobile:clean": "pkill -f 'metro' || true && pkill -f 'expo' || true && lsof -ti:8081 | xargs kill -9 || true",
    "mobile:build:dev:ios": "cd apps/mobile && npm run build:dev:ios",
    "mobile:build:dev:android": "cd apps/mobile && npm run build:dev:android",
    "mobile:build:dev:ios:local": "cd apps/mobile && npm run build:dev:ios:local",
    "mobile:build:dev:android:local": "cd apps/mobile && npm run build:dev:android:local",
    "mobile:install:dev:ios": "cd apps/mobile && npm run install:dev:ios",
    "mobile:install:dev:ios:local": "cd apps/mobile && npm run install:dev:ios:local",
    "mobile:install:dev:android:local": "cd apps/mobile && npm run install:dev:android:local",
    "mobile:install:dev:android": "cd apps/mobile && npm run install:dev:android",
    "mobile:dev:ios": "cd apps/mobile && npm run dev:ios",
    "mobile:dev:android": "cd apps/mobile && npm run dev:android",
    "dev:clean": "./scripts/dev-helper.sh clean",
    "dev:check": "./scripts/dev-helper.sh check",
    "dev:start": "./scripts/dev-helper.sh start",
    "web": "cd apps/web && npm run dev",
    "dev:supabase": "supabase start",
    "dev:waitlist-functions": "supabase functions serve waitlist-capture waitlist-ops --no-verify-jwt",
    "dev:all": "concurrently \"npm run dev:supabase\" \"npm run mobile\" \"npm run web\"",
    "gen:types": "./scripts/generate-types.sh",
    "gen:types:staging": "supabase gen types typescript --project-id $STAGING_PROJECT_REF > apps/mobile/src/types/database.ts && cp apps/mobile/src/types/database.ts apps/web/src/types/database.ts",
    "test": "npm run test:unit && npm run test:integration && npm run test:db",
    "test:all": "npm run test && npm run test:e2e",
    "test:unit": "npm run test:unit:mobile && npm run test:unit:web && npm run test:unit:shared && npm run test:unit:billing && npm run test:unit:admin && npm run test:unit:lifecycle-events && npm run test:unit:waitlist && npm run test:unit:email && npm run test:unit:marketing-email && npm run test:unit:logger && npm run test:unit:observability && npm run test:unit:scripts",
    "test:unit:mobile": "cd apps/mobile && npm test",
    "test:unit:web": "cd apps/web && npm test",
    "test:unit:shared": "cd packages/shared-tests && npm run test",
    "test:unit:billing": "cd packages/billing && npm test",
    "test:unit:admin": "cd packages/admin && npm test",
    "test:unit:lifecycle-events": "cd packages/lifecycle-events && npm test",
    "test:unit:waitlist": "cd packages/waitlist && npm test",
    "test:unit:email": "cd packages/email && npm test",
    "test:unit:marketing-email": "cd packages/marketing-email && npm test",
    "test:unit:logger": "cd packages/logger && npm test",
    "test:unit:observability": "cd packages/observability && npm test",
    "test:integration": "jest --config tests/jest.integration.config.js --forceExit",
    "test:integration:edge": "./scripts/run-integration-edge-tests.sh",
    "test:db": "node --test scripts/__tests__/db-migration-filenames.test.mjs && supabase test db",
    "test:db:pgtap": "supabase test db",
    "test:e2e": "npm run test:e2e:web && npm run test:e2e:mobile",
    "test:e2e:web": "export PATH=\"$PATH:$HOME/.maestro/bin\" && E2E_PW=\"${TEST_PASSWORD:-E2e_$(openssl rand -hex 16)_Aa1}\" && maestro test tests/e2e/web/flows/home.yaml --env WEB_URL=\"${WEB_URL:-http://localhost:5173}\" --env TEST_EMAIL=\"${TEST_EMAIL:-e2e-test-$(date +%s)@example.com}\" --env TEST_PASSWORD=\"$E2E_PW\"",
    "test:e2e:mobile": "export PATH=\"$PATH:$HOME/.maestro/bin\" && E2E_PW=\"${TEST_PASSWORD:-E2e_$(openssl rand -hex 16)_Aa1}\" && maestro test tests/e2e/mobile/flows/home.yaml --env MOBILE_APP_ID=\"${MOBILE_APP_ID:-com.anonymous.beakerstack}\" --env TEST_EMAIL=\"${TEST_EMAIL:-e2e-test-$(date +%s)@example.com}\" --env TEST_PASSWORD=\"$E2E_PW\"",
    "test:watch": "concurrently \"cd apps/mobile && npm run test:watch\" \"cd apps/web && npm run test:watch\" \"cd packages/shared-tests && npm run test:web -- --watch\" \"cd packages/shared-tests && npm run test:native -- --watch\"",
    "test:coverage": "export COVERAGE_MERGE=1 && npm run test:coverage:mobile && npm run test:coverage:web && npm run test:coverage:shared && npm run test:coverage:billing && npm run test:coverage:admin && npm run test:coverage:lifecycle-events && npm run test:coverage:waitlist && npm run test:coverage:email && npm run test:coverage:marketing-email && npm run test:coverage:logger && npm run test:coverage:observability && npm run test:coverage:merge",
    "test:coverage:mobile": "cd apps/mobile && npm test -- --coverage --passWithNoTests",
    "test:coverage:web": "cd apps/web && npm run test:coverage",
    "test:coverage:shared": "cd packages/shared-tests && npm run test:coverage",
    "test:coverage:billing": "cd packages/billing && npm run test:coverage",
    "test:coverage:admin": "cd packages/admin && npm run test:coverage",
    "test:coverage:lifecycle-events": "cd packages/lifecycle-events && npm run test:coverage",
    "test:coverage:waitlist": "cd packages/waitlist && npm run test:coverage",
    "test:coverage:email": "cd packages/email && npm run test:coverage",
    "test:coverage:marketing-email": "cd packages/marketing-email && npm run test:coverage",
    "test:coverage:logger": "cd packages/logger && npm run test:coverage",
    "test:coverage:observability": "cd packages/observability && npm run test:coverage",
    "test:coverage:merge": "node scripts/merge-coverage.js",
    "test:unit:scripts": "node --test scripts/__tests__/rename-project.test.mjs scripts/__tests__/detect-repo-identity.test.mjs scripts/__tests__/setup-aws-discover.test.mjs scripts/__tests__/setup-dotenv.test.mjs scripts/__tests__/setup-manifest-github-sync.test.mjs scripts/__tests__/setup-secret-input.test.mjs scripts/__tests__/setup-supabase-pick-recommend.test.mjs scripts/__tests__/billing-webhook-guards.test.mjs scripts/__tests__/setup-stripe.test.mjs scripts/__tests__/ensure-stripe-webhook.test.mjs scripts/__tests__/merge-coverage.test.mjs scripts/__tests__/format-supabase-test-summary.test.mjs scripts/__tests__/setup-route53-email-records.test.mjs scripts/__tests__/setup-resend-api.test.mjs scripts/__tests__/setup-resend-keys.test.mjs scripts/__tests__/setup-google-oauth.test.mjs scripts/__tests__/email-config-subjects.test.mjs && ./scripts/pr-preview/check-preview-deploy-needed.sh --self-test",
    "lint": "npm run lint:mobile && npm run lint:web && npm run lint:shared && npm run lint:billing && npm run lint:admin && npm run lint:lifecycle-events && npm run lint:waitlist && npm run lint:email && npm run lint:marketing-email && npm run lint:logger && npm run lint:observability && npm run lint:repo && npm run lint:supabase",
    "lint:mobile": "eslint apps/mobile/src --ext ts,tsx --report-unused-disable-directives",
    "lint:web": "eslint apps/web/src --ext ts,tsx --report-unused-disable-directives",
    "lint:shared": "eslint packages/shared/src --ext ts,tsx --report-unused-disable-directives",
    "lint:repo": "eslint scripts tests packages/shared-tests packages/test-utils/src apps/mobile/__tests__ --ext ts,tsx,js,mjs,cjs --report-unused-disable-directives",
    "lint:supabase": "eslint supabase/functions --ext ts,mjs --report-unused-disable-directives",
    "lint:billing": "eslint packages/billing/src --ext ts,tsx --report-unused-disable-directives",
    "lint:admin": "eslint packages/admin/src --ext ts,tsx --report-unused-disable-directives",
    "lint:lifecycle-events": "eslint packages/lifecycle-events/src --ext ts --report-unused-disable-directives",
    "lint:waitlist": "eslint packages/waitlist/src --ext ts,tsx --report-unused-disable-directives",
    "lint:email": "eslint packages/email/src --ext ts --report-unused-disable-directives",
    "lint:marketing-email": "eslint packages/marketing-email/src --ext ts --report-unused-disable-directives",
    "lint:logger": "eslint packages/logger/src --ext ts --report-unused-disable-directives",
    "lint:observability": "eslint packages/observability/src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:strict": "npm run lint:mobile -- --max-warnings 0 && npm run lint:web -- --max-warnings 0 && npm run lint:shared -- --max-warnings 0 && npm run lint:billing -- --max-warnings 0 && npm run lint:repo -- --max-warnings 0",
    "lint:fix": "eslint apps/mobile/src apps/web/src packages/shared/src packages/billing/src scripts tests packages/shared-tests packages/test-utils/src apps/mobile/__tests__ --ext ts,tsx,js,mjs,cjs --fix",
    "pretype-check": "cd packages/shared && npm run build",
    "type-check": "npm run type-check:mobile && npm run type-check:web && npm run type-check:shared && npm run type-check:billing && npm run type-check:admin && npm run type-check:lifecycle-events && npm run type-check:waitlist && npm run type-check:email && npm run type-check:marketing-email && npm run type-check:logger && npm run type-check:observability",
    "type-check:mobile": "cd apps/mobile && npx tsc --noEmit",
    "type-check:web": "cd apps/web && npx tsc --noEmit",
    "type-check:shared": "cd packages/shared && npx tsc --noEmit",
    "type-check:billing": "cd packages/billing && npx tsc --noEmit",
    "type-check:admin": "cd packages/admin && npx tsc --noEmit",
    "type-check:lifecycle-events": "cd packages/lifecycle-events && npx tsc --noEmit",
    "type-check:waitlist": "cd packages/waitlist && npx tsc --noEmit",
    "type-check:email": "cd packages/email && npx tsc --noEmit",
    "type-check:marketing-email": "cd packages/marketing-email && npx tsc --noEmit",
    "type-check:logger": "cd packages/logger && npx tsc --noEmit",
    "type-check:observability": "cd packages/observability && npx tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:link:local": "supabase link --project-ref local",
    "db:link:pr": "supabase link --project-ref $PR_TESTING_SUPABASE_PROJECT_REF",
    "db:link:staging": "supabase link --project-ref $STAGING_SUPABASE_PROJECT_REF",
    "db:link:production": "supabase link --project-ref $PRODUCTION_SUPABASE_PROJECT_REF",
    "db:reset:pr": "./scripts/reset-pr-database.sh",
    "db:status": "supabase db status",
    "db:check": "./scripts/check-db-status.sh",
    "db:diff": "supabase db diff",
    "migration:new": "supabase migration new",
    "migration:up": "supabase migration up",
    "migration:list": "supabase migration list",
    "setup": "node ./scripts/setup-menu.mjs",
    "setup:local": "./scripts/setup-local.sh",
    "setup:full": "node ./scripts/setup-full.mjs",
    "setup-full": "node ./scripts/setup-full.mjs",
    "setup:email": "node ./scripts/setup-email-dns.mjs",
    "email:personalize": "node scripts/personalize-email-templates.mjs",
    "email:materialize-config": "node scripts/materialize-email-config.mjs --in-place",
    "setup:diagnose-secret-input": "node ./scripts/dev-diagnose-secret-input.mjs",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist apps/*/build",
    "clean:all": "npm run clean && supabase stop && docker system prune -f",
    "prepare": "husky install",
    "postinstall": "patch-package || true",
    "rename": "node ./scripts/rename-project.mjs",
    "setup:project-label-bridge": "node scripts/github/setup-project-label-bridge.mjs",
    "docs:actions-secrets": "node ./scripts/generate-actions-secrets-doc.mjs",
    "docs:linkcheck": "bash -c 'set -euo pipefail; shopt -s nullglob; files=(README.md QUICKSTART.md CONTRIBUTING.md SECURITY.md docs/*.md docs/guides/*.md docs/internal/*.md docs/oauth/*.md docs/reference/*.md docs/specs/*.md docs/testing/*.md); npx --yes markdown-link-check@3.12.2 \"${files[@]}\" -c .markdown-link-check.json'",
    "billing:sync-stripe": "node scripts/sync-billing-stripe.mjs --config packages/billing/src/presentation/billing-sync.json",
    "stripe:ensure-webhook": "node scripts/ensure-stripe-webhook-endpoint.mjs",
    "billing:apply-plans": "tsx scripts/apply-billing-plans-from-config.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "admin:revoke": "tsx scripts/revoke-admin.ts"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@changesets/changelog-github": "0.6.0",
    "@changesets/cli": "2.31.0",
    "@supabase/supabase-js": "^2.38.0",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "nyc": "^17.1.0",
    "prettier": "^3.1.0",
    "stripe": "^14.21.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.3.0",
    "ws": "^8.20.1"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-test-renderer": "18.2.0",
    "@types/react": "18.2.0",
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "node-forge": "^1.3.4",
    "postcss": "^8.5.10",
    "semver": "^7.6.3",
    "send": "^0.19.0",
    "tar": "^7.5.11",
    "yaml": "^2.8.3",
    "cacache": {
      "tar": "^7.5.11"
    },
    "@expo/image-utils": {
      "semver": "^7.6.3"
    },
    "fast-xml-parser": "5.7.1",
    "fast-uri": "^3.1.2",
    "fast-xml-builder": "^1.1.7",
    "@react-native-community/cli-platform-android@12.3.6": {
      "fast-xml-parser": "5.7.1"
    },
    "@react-native-community/cli-platform-ios@12.3.6": {
      "fast-xml-parser": "5.7.1"
    },
    "@xmldom/xmldom": "0.8.13",
    "@expo/plist": "0.5.2",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.5",
    "jest-expo@50.0.4": {
      "jest-environment-jsdom": {
        "jsdom": "^26.1.0"
      }
    },
    "eas-cli": {
      "minimatch": "^9.0.9",
      "ajv": "^8.18.0",
      "yaml": "^2.8.3",
      "node-forge": "^1.3.4",
      "send": "^0.19.0"
    },
    "expo-dev-launcher": {
      "ajv": "^8.18.0"
    },
    "uuid": "14.0.0",
    "diff": "^8.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
